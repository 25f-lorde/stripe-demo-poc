# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (NEVER commit — contains Stripe secret keys and DB credentials)
.env
.env.local
.env.production
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# drizzle
drizzle/meta/

# prisma (legacy)
/app/generated/prisma
prisma/dev.db
prisma/dev.db-journal

# playwright
.playwright-mcp/

# editor
.vscode/
.idea/

# sqlite (if used locally)
*.db
*.db-journal
test-results/
